generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Enumerations ---- //

enum ActionType {
  CREATE @map("create")
  UPDATE @map("update")
  DELETE @map("delete")
}

enum ActorType {
  SYSTEM @map("system")
  MEMBER @map("member")
  API    @map("api")
}

enum ContactRecord {
  PERSON  @map("person")
  COMPANY @map("company")
}

enum ContactStage {
  LEAD           @map("lead")
  QUALIFIED      @map("qualified")
  OPPORTUNITY    @map("opportunity")
  PROPOSAL       @map("proposal")
  IN_NEGOTIATION @map("inNegotiation")
  LOST           @map("lost")
  WON            @map("won")
}

enum ContactTaskStatus {
  OPEN        @map("open")
  IN_PROGRESS @map("inProgress")
  COMPLETED   @map("completed")
  CANCELLED   @map("cancelled")
}

enum SoftwareStatus {
  UP_TO_DATE       @map("upToDate")
  UPDATE_AVAILABLE @map("updateAvailable")
  NEEDS_ATTENTION  @map("needsAttention")
  TRIAL            @map("trial")
  NOT_INSTALLED    @map("notInstalled")
}

enum DayOfWeek {
  SUNDAY    @map("sunday")
  MONDAY    @map("monday")
  TUESDAY   @map("tuesday")
  WEDNESDAY @map("wednesday")
  THURSDAY  @map("thursday")
  FRIDAY    @map("friday")
  SATURDAY  @map("saturday")
}

enum FeedbackCategory {
  SUGGESTION @map("suggestion")
  PROBLEM    @map("problem")
  QUESTION   @map("question")
}

enum InvitationStatus {
  PENDING  @map("pending")
  ACCEPTED @map("accepted")
  REVOKED  @map("revoked")
}

enum Role {
  MEMBER @map("member")
  ADMIN  @map("admin")
  CLIENT @map("client")
}

enum WebhookTrigger {
  CONTACT_CREATED @map("contactCreated")
  CONTACT_UPDATED @map("contactUpdated")
  CONTACT_DELETED @map("contactDeleted")
}

enum EmailFolder {
  INBOX @map("inbox")
  SENT  @map("sent")
}

enum EmailSenderType {
  USER    @map("user")
  CONTACT @map("contact")
}

enum ContactPriority {
  LOW    @map("low")
  MEDIUM @map("medium")
  HIGH   @map("high")
}

enum ContactMeetingStatus {
  PENDING   @map("pending")
  CONFIRMED @map("confirmed")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")
}

enum ContactTaskCategory {
  SALES      @map("sales")
  ONBOARDING @map("onboarding")
  SUPPORT    @map("support")
  FOLLOW_UP  @map("followUp")
}

enum ContactTicketStatus {
  OPEN     @map("open")
  PENDING  @map("pending")
  RESOLVED @map("resolved")
  CLOSED   @map("closed")
}

enum ContactTicketActivityType {
  CREATED          @map("created")
  ASSIGNED         @map("assigned")
  STATUS_CHANGED   @map("statusChanged")
  PRIORITY_CHANGED @map("priorityChanged")
  REPLIED          @map("replied")
  NOTE_ADDED       @map("noteAdded")
}

enum TicketMessageSender {
  USER    @map("user")
  CONTACT @map("contact")
}

// ---- Models ---- //

model Account {
  id                String   @id(map: "PK_Account") @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "IX_Account_userId")
}

model ApiKey {
  id             String       @id(map: "PK_ApiKey") @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  description    String       @db.VarChar(70)
  hashedKey      String       @unique()
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId], map: "IX_ApiKey_organizationId")
}

model AuthenticatorApp {
  id            String   @id(map: "PK_AuthenticatorApp") @default(uuid()) @db.Uuid
  userId        String   @unique @db.Uuid
  accountName   String   @db.VarChar(255)
  issuer        String   @db.VarChar(255)
  secret        String   @db.VarChar(255)
  recoveryCodes String   @db.VarChar(1024)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId], map: "IX_AuthenticatorApp_userId")
}

model ChangeEmailRequest {
  id        String   @id(map: "PK_ChangeEmailRequest") @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  email     String
  expires   DateTime
  valid     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId], map: "IX_ChangeEmailRequest_userId")
}

model Contact {
  id                String             @id(map: "PK_Contact") @default(uuid()) @db.Uuid
  organizationId    String             @db.Uuid
  record            ContactRecord      @default(PERSON)
  image             String?            @db.VarChar(2048)
  name              String             @db.VarChar(255)
  email             String?            @db.VarChar(255)
  address           String?            @db.VarChar(255)
  phone             String?            @db.VarChar(32)
  stage             ContactStage       @default(LEAD)
  productInterest   String?            @db.VarChar(255)
  hearAboutUs       String?            @db.VarChar(255)
  description       String?            @db.VarChar(5000)
  // Extended properties
  jobTitle          String?            @db.VarChar(128)
  company           String?            @db.VarChar(255)
  website           String?            @db.VarChar(2048)
  linkedIn          String?            @db.VarChar(2048)
  country           String?            @db.VarChar(128)
  timezone          String?            @db.VarChar(64)
  leadSource        String?            @db.VarChar(255)
  leadSourceDate    DateTime?
  // Activity
  lastContactedAt   DateTime?
  lastContactedNote String?            @db.VarChar(255)
  lastMeetingAt     DateTime?
  lastMeetingNote   String?            @db.VarChar(255)
  // Stripe
  stripeCustomerId  String?            @db.VarChar(255)
  isRead            Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  activities        ContactActivity[]
  comments          ContactComment[]
  notes             ContactNote[]
  pageVisits        ContactPageVisit[]
  tags              ContactTag[]
  favorites         Favorite[]
  tasks             ContactTask[]
  software          ContactSoftware[]
  emailThreads      ContactEmailThread[]
  meetings          ContactMeeting[]
  tickets           ContactTicket[]
  clientUsers       User[]             @relation("ClientUserContact")

  @@index([organizationId], map: "IX_Contact_organizationId")
}

model ContactActivity {
  id         String     @id(map: "PK_ContactActivity") @default(uuid()) @db.Uuid
  contactId  String     @db.Uuid
  actionType ActionType
  actorId    String     @db.VarChar(255)
  actorType  ActorType
  metadata   Json?
  occurredAt DateTime   @default(now())
  contact    Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([contactId], map: "IX_ContactActivity_contactId")
  @@index([occurredAt], map: "IX_ContactActivity_occurredAt")
}

model ContactComment {
  id        String   @id(map: "PK_ContactComment") @default(uuid()) @db.Uuid
  contactId String   @db.Uuid
  userId    String   @db.Uuid
  text      String   @db.VarChar(2000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([contactId], map: "IX_ContactComment_contactId")
  @@index([userId], map: "IX_ContactComment_userId")
}

model ContactImage {
  id          String  @id(map: "PK_ContactImage") @default(uuid()) @db.Uuid
  contactId   String  @db.Uuid
  data        Bytes?
  contentType String? @db.VarChar(255)
  hash        String? @db.VarChar(64)

  @@index([contactId], map: "IX_ContactImage_contactId")
}

model ContactNote {
  id        String          @id(map: "PK_ContactNote") @default(uuid()) @db.Uuid
  contactId String          @db.Uuid
  userId    String          @db.Uuid
  text      String?         @db.VarChar(8000)
  priority  ContactPriority @default(MEDIUM)
  pinned    Boolean         @default(false)
  meetingId String?         @db.Uuid
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  contact   Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  meeting   ContactMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([contactId], map: "IX_ContactNote_contactId")
  @@index([userId], map: "IX_ContactNote_userId")
  @@index([meetingId], map: "IX_ContactNote_meetingId")
}

model ContactPageVisit {
  id        String   @id(map: "PK_ContactPageVisit") @default(uuid()) @db.Uuid
  contactId String   @db.Uuid
  userId    String?  @db.Uuid
  timestamp DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([contactId], map: "IX_ContactPageVisit_contactId")
  @@index([userId], map: "IX_ContactPageVisit_userId")
}

model ContactTag {
  id       String    @id(map: "PK_ContactTag") @default(uuid()) @db.Uuid
  text     String    @unique @db.VarChar(128)
  contacts Contact[]
}

model ContactTask {
  id             String               @id(map: "PK_ContactTask") @default(uuid()) @db.Uuid
  contactId      String               @db.Uuid
  title          String               @db.VarChar(255)
  description    String?              @db.VarChar(8000)
  status         ContactTaskStatus    @default(OPEN)
  priority       ContactPriority      @default(MEDIUM)
  category       ContactTaskCategory?
  assigneeUserId String?              @db.Uuid
  meetingId      String?              @db.Uuid
  dueDate        DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  contact        Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignee       User?                @relation(fields: [assigneeUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  meeting        ContactMeeting?      @relation(fields: [meetingId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([contactId], map: "IX_ContactTask_contactId")
  @@index([assigneeUserId], map: "IX_ContactTask_assigneeUserId")
  @@index([meetingId], map: "IX_ContactTask_meetingId")
}

model ContactSoftware {
  id               String         @id(map: "PK_ContactSoftware") @default(uuid()) @db.Uuid
  contactId        String         @db.Uuid
  name             String         @db.VarChar(255)
  installedVersion String?        @db.VarChar(32)
  latestVersion    String?        @db.VarChar(32)
  installDate      DateTime?
  status           SoftwareStatus @default(UP_TO_DATE)
  githubUrl        String?        @db.VarChar(2048)
  docsUrl          String?        @db.VarChar(2048)
  downloadUrl      String?        @db.VarChar(2048)
  licenseKey       String?        @db.VarChar(255)
  licenseType      String?        @db.VarChar(128)
  seats            Int?
  os               String?        @db.VarChar(128)
  database         String?        @db.VarChar(128)
  installPath      String?        @db.VarChar(512)
  notes            String?        @db.VarChar(8000)
  clientUnread     Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  contact          Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([contactId], map: "IX_ContactSoftware_contactId")
}

model SoftwareRelease {
  id          String   @id(map: "PK_SoftwareRelease") @default(uuid()) @db.Uuid
  product     String   @db.VarChar(255)
  version     String   @db.VarChar(64)
  releaseDate DateTime @db.Date
  downloadUrl String?  @db.VarChar(2048)
  notes       String?  @db.VarChar(8000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([product, version], map: "UX_SoftwareRelease_product_version")
  @@index([product, releaseDate], map: "IX_SoftwareRelease_product_releaseDate")
}

model ContactEmailThread {
  id            String                @id(map: "PK_ContactEmailThread") @default(uuid()) @db.Uuid
  contactId     String                @db.Uuid
  folder        EmailFolder
  subject       String                @db.VarChar(500)
  preview       String                @db.VarChar(500)
  unread        Boolean               @default(false)
  // Per-side soft-delete flags so admin and client each have an independent
  // "trash" view (Gmail-style). A delete from one side only hides the thread
  // for that side; the other party can still see it and reply. A reply from
  // either side resets the OPPOSITE flag so the message reappears for the
  // recipient. When both flags are true, the delete action hard-removes the
  // row to keep the table from growing forever.
  clientDeleted Boolean               @default(false)
  teamDeleted   Boolean               @default(false)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  contact       Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  messages      ContactEmailMessage[]

  @@index([contactId], map: "IX_ContactEmailThread_contactId")
  @@index([updatedAt], map: "IX_ContactEmailThread_updatedAt")
}

model ContactEmailMessage {
  id            String                          @id(map: "PK_ContactEmailMessage") @default(uuid()) @db.Uuid
  threadId      String                          @db.Uuid
  senderType    EmailSenderType
  senderUserId  String?                         @db.Uuid
  senderName    String                          @db.VarChar(255)
  senderEmail   String?                         @db.VarChar(255)
  recipientName String?                         @db.VarChar(255)
  recipientEmail String?                        @db.VarChar(255)
  body          String                          @db.VarChar(20000)
  createdAt     DateTime                        @default(now())
  thread        ContactEmailThread              @relation(fields: [threadId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  senderUser    User?                           @relation(fields: [senderUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  attachments   ContactEmailMessageAttachment[]

  @@index([threadId], map: "IX_ContactEmailMessage_threadId")
  @@index([senderUserId], map: "IX_ContactEmailMessage_senderUserId")
}

model ContactEmailMessageAttachment {
  id        String              @id(map: "PK_ContactEmailMessageAttachment") @default(uuid()) @db.Uuid
  messageId String              @db.Uuid
  fileName  String              @db.VarChar(255)
  storedName String             @db.VarChar(255)
  mimeType  String              @db.VarChar(255)
  sizeBytes Int
  createdAt DateTime            @default(now())
  message   ContactEmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([messageId], map: "IX_ContactEmailMessageAttachment_messageId")
}

model ContactMeeting {
  id          String               @id(map: "PK_ContactMeeting") @default(uuid()) @db.Uuid
  contactId   String               @db.Uuid
  title       String               @db.VarChar(255)
  description String?              @db.VarChar(2000)
  startsAt    DateTime
  endsAt      DateTime
  location    String?              @db.VarChar(255)
  status      ContactMeetingStatus @default(PENDING)
  clientUnread Boolean             @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  contact     Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  notes       ContactNote[]
  tasks       ContactTask[]
  tickets     ContactTicket[]
  files       ContactMeetingFile[]

  @@index([contactId], map: "IX_ContactMeeting_contactId")
  @@index([startsAt], map: "IX_ContactMeeting_startsAt")
}

model ContactMeetingFile {
  id           String         @id(map: "PK_ContactMeetingFile") @default(uuid()) @db.Uuid
  meetingId    String         @db.Uuid
  uploadedById String?        @db.Uuid
  name         String         @db.VarChar(500)
  contentType  String         @db.VarChar(255)
  size         Int
  data         Bytes
  createdAt    DateTime       @default(now())
  meeting      ContactMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  uploadedBy   User?          @relation("UploadedMeetingFiles", fields: [uploadedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([meetingId], map: "IX_ContactMeetingFile_meetingId")
  @@index([uploadedById], map: "IX_ContactMeetingFile_uploadedById")
}

model ContactTicket {
  id             String                  @id(map: "PK_ContactTicket") @default(uuid()) @db.Uuid
  number         Int                     @default(autoincrement())
  contactId      String                  @db.Uuid
  meetingId      String?                 @db.Uuid
  title          String                  @db.VarChar(255)
  description    String?                 @db.VarChar(8000)
  status         ContactTicketStatus     @default(OPEN)
  priority       ContactPriority         @default(MEDIUM)
  assigneeUserId String?                 @db.Uuid
  clientUnread   Boolean                 @default(false)
  createdByClient Boolean                @default(false)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  contact        Contact                 @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  meeting        ContactMeeting?         @relation(fields: [meetingId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  assignee       User?                   @relation("AssignedTickets", fields: [assigneeUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  messages       ContactTicketMessage[]
  activities     ContactTicketActivity[]

  @@unique([number], map: "UQ_ContactTicket_number")
  @@index([contactId], map: "IX_ContactTicket_contactId")
  @@index([meetingId], map: "IX_ContactTicket_meetingId")
  @@index([assigneeUserId], map: "IX_ContactTicket_assigneeUserId")
  @@index([status], map: "IX_ContactTicket_status")
}

model ContactTicketMessage {
  id             String                          @id(map: "PK_ContactTicketMessage") @default(uuid()) @db.Uuid
  ticketId       String                          @db.Uuid
  senderType     TicketMessageSender
  senderUserId   String?                         @db.Uuid
  senderName     String                          @db.VarChar(255)
  body           String                          @db.VarChar(20000)
  isInternalNote Boolean                         @default(false)
  createdAt      DateTime                        @default(now())
  ticket         ContactTicket                   @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  senderUser     User?                           @relation("AuthoredTicketMessages", fields: [senderUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  attachments    ContactTicketMessageAttachment[]

  @@index([ticketId], map: "IX_ContactTicketMessage_ticketId")
  @@index([senderUserId], map: "IX_ContactTicketMessage_senderUserId")
}

model ContactTicketMessageAttachment {
  id            String               @id(map: "PK_ContactTicketMessageAttachment") @default(uuid()) @db.Uuid
  messageId     String               @db.Uuid
  fileName      String               @db.VarChar(255)
  storedName    String               @db.VarChar(255)
  mimeType      String               @db.VarChar(255)
  sizeBytes     Int
  createdAt     DateTime             @default(now())
  message       ContactTicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([messageId], map: "IX_ContactTicketMessageAttachment_messageId")
}

model ContactTicketActivity {
  id          String                    @id(map: "PK_ContactTicketActivity") @default(uuid()) @db.Uuid
  ticketId    String                    @db.Uuid
  type        ContactTicketActivityType
  description String                    @db.VarChar(500)
  userId      String?                   @db.Uuid
  createdAt   DateTime                  @default(now())
  ticket      ContactTicket             @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user        User?                     @relation("LoggedTicketActivities", fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([ticketId], map: "IX_ContactTicketActivity_ticketId")
}

model Favorite {
  id        String  @id(map: "PK_Favorite") @default(uuid()) @db.Uuid
  userId    String  @db.Uuid
  contactId String  @db.Uuid
  order     Int     @default(0)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId], map: "IX_Favorite_userId")
  @@index([contactId], map: "IX_Favorite_contactId")
}

model Feedback {
  id             String           @id(map: "PK_Feedback") @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String?          @db.Uuid
  category       FeedbackCategory @default(SUGGESTION)
  message        String           @db.VarChar(4000)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([organizationId], map: "IX_Feedback_organizationId")
  @@index([userId], map: "IX_Feedback_userId")
}

model Invitation {
  id             String           @id(map: "PK_Invitation") @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  token          String           @default(uuid()) @db.Uuid
  email          String           @db.VarChar(255)
  role           Role             @default(MEMBER)
  status         InvitationStatus @default(PENDING)
  lastSentAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId], map: "IX_Invitation_organizationId")
  @@index([token], map: "IX_Invitation_token")
}

model Notification {
  id        String    @id(map: "PK_Notification") @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  subject   String?   @db.VarChar(128)
  content   String    @db.VarChar(8000)
  link      String?   @db.VarChar(2000)
  // Set when the notification is about client activity on a CRM contact
  // (a ticket / message the client created) — drives the per-row badge on
  // the Contacts table.
  contactId String?   @db.Uuid
  type      String?   @db.VarChar(32)
  seenAt    DateTime?
  dismissed Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId], map: "IX_Notification_userId")
  @@index([contactId], map: "IX_Notification_contactId")
}

model Organization {
  id                  String       @id(map: "PK_Organization") @default(uuid()) @db.Uuid
  stripeCustomerId    String
  name                String       @db.VarChar(255)
  address             String?      @db.VarChar(255)
  phone               String?      @db.VarChar(32)
  email               String?      @db.VarChar(255)
  website             String?      @db.VarChar(2000)
  linkedInProfile     String?      @db.VarChar(2000)
  instagramProfile    String?      @db.VarChar(2000)
  youTubeChannel      String?      @db.VarChar(2000)
  xProfile            String?      @db.VarChar(2000)
  tikTokProfile       String?      @db.VarChar(2000)
  facebookPage        String?      @db.VarChar(2000)
  completedOnboarding Boolean      @default(false)
  tier                String       @default("free") @db.VarChar(255)
  apiKeys             ApiKey[]
  businessHours       WorkHours[]
  contacts            Contact[]
  feedback            Feedback[]
  invitations         Invitation[]
  users               User[]
  webhooks            Webhook[]

  @@index([stripeCustomerId], map: "IX_Organization_stripeCustomerId")
}

model Purchase {
  id                    String    @id @default(cuid())
  email                 String
  customerName          String
  stripeCustomerId      String?
  stripeSessionId       String    @unique
  stripePaymentId       String?
  amount                Int // Amount in cents
  currency              String    @default("usd")
  status                String    @default("pending") // pending, completed, failed
  downloadToken         String    @unique @default(cuid())
  downloadCount         Int       @default(0)
  maxDownloads          Int       @default(1)
  // New license key fields
  licenseKey            String?
  licenseKeyHash        String?   @unique
  licenseStatus         String    @default("inactive") // inactive, active, revoked
  activatedAt           DateTime?
  activatedEmail        String?
  systemFingerprint     String?
  processorId           String?
  activationAttempts    Int       @default(0)
  maxActivationAttempts Int       @default(3)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  expiresAt             DateTime? // Optional expiration for download link

  activations LicenseActivation[]
  licenseUsers LicenseUser[]

  @@map("purchases")
}

// Operator/seat emails registered under a license by the desktop app. Lets the
// password-reset flow recognise local FCP operators (who aren't otherwise web
// accounts/customers) so they can receive a 6-digit reset code, and gives a
// roster of who is using each license.
model LicenseUser {
  id         String   @id @default(cuid())
  purchaseId String
  email      String
  name       String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@unique([purchaseId, email])
  @@index([email])
  @@index([purchaseId])
  @@map("license_users")
}

model LicenseActivation {
  id                String   @id @default(cuid())
  purchaseId        String
  email             String
  systemFingerprint String
  processorId       String?
  ipAddress         String?
  userAgent         String?
  status            String // success, failed, blocked
  errorMessage      String?
  createdAt         DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@map("license_activations")
}

model ResetPasswordRequest {
  id        String   @id(map: "PK_ResetPasswordRequest") @default(uuid()) @db.Uuid
  email     String
  expires   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email], map: "IX_ResetPasswordRequest_email")
}

// 6-digit code password-reset flow used by the desktop app via the public
// API (app/(app)/api/auth/password-reset/*). The code itself is never stored
// in plaintext: `codeHash` is an HMAC-SHA256 of `${email}:${code}` keyed with
// AUTH_SECRET, so a database leak alone cannot reveal a code. `userId` /
// `requestedName` are a best-effort snapshot of who requested the reset (for
// the admin audit view); they are null when the email belongs to a license
// holder or CRM contact rather than a dashboard User.
model PasswordResetCode {
  id            String    @id(map: "PK_PasswordResetCode") @default(uuid()) @db.Uuid
  email         String    @db.VarChar(255)
  userId        String?   @db.Uuid
  requestedName String?   @db.VarChar(255)
  codeHash      String    @db.VarChar(128)
  expires       DateTime
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  consumedAt    DateTime?
  ipAddress     String?   @db.VarChar(64)
  userAgent     String?   @db.VarChar(512)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([email], map: "IX_PasswordResetCode_email")
  @@index([userId], map: "IX_PasswordResetCode_userId")
  @@index([createdAt], map: "IX_PasswordResetCode_createdAt")
}

model Session {
  id           String   @id(map: "PK_Session") @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId], map: "IX_Session_userId")
}

model User {
  id                           String               @id(map: "PK_User") @default(uuid()) @db.Uuid
  organizationId               String?              @db.Uuid
  contactId                    String?              @db.Uuid
  image                        String?              @db.VarChar(2048)
  name                         String               @db.VarChar(64)
  email                        String?              @unique
  emailVerified                DateTime?
  password                     String?              @db.VarChar(60)
  lastLogin                    DateTime?
  role                         Role                 @default(MEMBER)
  phone                        String?              @db.VarChar(32)
  locale                       String               @default("en-US") @db.VarChar(8)
  completedOnboarding          Boolean              @default(false)
  enabledContactsNotifications Boolean              @default(false)
  enabledInboxNotifications    Boolean              @default(false)
  enabledWeeklySummary         Boolean              @default(false)
  enabledNewsletter            Boolean              @default(false)
  enabledProductUpdates        Boolean              @default(false)
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  accounts                     Account[]
  authenticatorApp             AuthenticatorApp?
  changeEmailRequests          ChangeEmailRequest[]
  passwordResetCodes           PasswordResetCode[]
  comments                     ContactComment[]
  favorites                    Favorite[]
  feedback                     Feedback[]
  notes                        ContactNote[]
  notifications                Notification[]
  organization                 Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  pageVisits                   ContactPageVisit[]
  sessions                     Session[]
  emailMessages                ContactEmailMessage[]
  assignedTasks                ContactTask[]
  assignedTickets              ContactTicket[]          @relation("AssignedTickets")
  authoredTicketMessages       ContactTicketMessage[]   @relation("AuthoredTicketMessages")
  loggedTicketActivities       ContactTicketActivity[]  @relation("LoggedTicketActivities")
  uploadedMeetingFiles         ContactMeetingFile[]     @relation("UploadedMeetingFiles")
  contact                      Contact?                 @relation("ClientUserContact", fields: [contactId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([organizationId], map: "IX_User_organizationId")
  @@index([contactId], map: "IX_User_contactId")
}

model UserImage {
  id          String  @id(map: "PK_UserImage") @default(uuid()) @db.Uuid
  userId      String  @db.Uuid
  data        Bytes?
  contentType String? @db.VarChar(255)
  hash        String? @db.VarChar(64)

  @@index([userId], map: "IX_UserImage_userId")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Webhook {
  id             String           @id(map: "PK_Webhook") @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  url            String           @db.VarChar(2000)
  triggers       WebhookTrigger[]
  secret         String?          @db.VarChar(1024)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "IX_Webhook_organizationId")
}

model WorkHours {
  id             String         @id(map: "PK_WorkHours") @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  dayOfWeek      DayOfWeek      @default(SUNDAY)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  timeSlots      WorkTimeSlot[]

  @@index([organizationId], map: "IX_WorkHours_organizationId")
}

model WorkTimeSlot {
  id          String    @id(map: "PK_WorkTimeSlot") @default(uuid()) @db.Uuid
  workHoursId String    @db.Uuid
  start       DateTime  @db.Time(0)
  end         DateTime  @db.Time(0)
  workHours   WorkHours @relation(fields: [workHoursId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([workHoursId], map: "IX_WorkTimeSlot_workHoursId")
}
