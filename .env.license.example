# License System Configuration
# Add these to your existing .env file.

# Decorative key-payload encryption used by lib/license/license-key-generator.ts.
# Lookups go by SHA-256 hash, so this is not the security boundary, but set a
# real 32+ char secret in production anyway.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LICENSE_ENCRYPTION_KEY="your-very-secure-encryption-key-here-32-chars-minimum-length-required"

# Tamper-proof validation signing (ECDSA P-256 / ES256). When set, /api/license/validate
# attaches a signature the desktop verifies with its EMBEDDED public key, so a
# fake / MITM license server cannot forge a "valid" response. Leave unset in
# local dev (validation still works, just unsigned).
# Generate the keypair: npx tsx scripts/generate-license-signing-keys.ts
# Paste the printed base64 PEM here (single line):
LICENSE_SIGNING_PRIVATE_KEY=""
# Optional — only if you want the server to expose the public key explicitly;
# otherwise it is derived from the private key.
# LICENSE_SIGNING_PUBLIC_KEY=""

# Trial length in days for POST /api/license/trial (default 7).
LICENSE_TRIAL_DAYS="7"

# Signing/verifying gated software-download tokens (already used by
# /api/software/latest + /api/software/download).
# SOFTWARE_DOWNLOAD_SECRET="..."

# App-wide shared secret for the desktop forgot-password endpoints (sent by the
# desktop as the X-Api-Key header). This MUST equal the value embedded in the
# desktop build (LicenseApiOptions.EmbeddedPasswordResetApiKey). The
# /api/auth/password-reset/* endpoints fail CLOSED (503) until this is set.
# NOT the license key — it's one fixed value for every install. Rotate by
# changing BOTH sides together. The value below matches the current desktop
# placeholder; generate your own for production.
PASSWORD_RESET_API_KEY="067a5149af81a65af08b290502cec7ab90ca27ee82427bdb4694a5132e0a403d"
