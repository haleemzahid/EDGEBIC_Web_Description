# GENERAL
NEXT_PUBLIC_APP_NAME=YourAppName
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BUNDLE_ANALYZER=false

# SEO - Search Engine Verification (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code
NEXT_PUBLIC_BING_SITE_VERIFICATION=your-bing-verification-code
NEXT_PUBLIC_YANDEX_VERIFICATION=your-yandex-verification-code

# AUTH
# Generate a new AUTH_SECRET with: openssl rand -base64 32 or npx auth secret
AUTH_SECRET=your-auth-secret-here

# Shared secret for the desktop-app password-reset API
# (app/(app)/api/auth/password-reset/*). The desktop app sends this as the
# `X-Api-Key` header. The endpoints FAIL CLOSED: if this is unset, every
# request is rejected with 503. Generate with: openssl rand -hex 32
PASSWORD_RESET_API_KEY=your-password-reset-api-key-here

AUTH_GOOGLE_CLIENT_ID=your-google-client-id
AUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
AUTH_MICROSOFT_ENTRA_ID_CLIENT_ID=your-microsoft-client-id
AUTH_MICROSOFT_ENTRA_ID_CLIENT_SECRET=your-microsoft-client-secret

# DATABASE
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# BILLING - Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
PRO_PRODUCT_ID=prod_your_product_id
PRO_PRODUCT_PRICE_ID=price_your_price_id
NTCLIPBOARD_PRODUCT_PRICE_ID=price_your_price_id
SMARTDESKAPP_PRODUCT_PRICE_ID=price_your_price_id
SMART_DESK_APP_PRODUCT_PRICE_ID=price_your_price_id

# Donation price IDs
DONATION_COFFEE_PRICE_ID=price_your_coffee_donation_id
DONATION_SPONSOR_PRICE_ID=price_your_sponsor_donation_id
DONATION_CUSTOM_PRICE_ID=price_your_custom_donation_id

BILLING_UNIT=per_seat # per_seat | per_organization

# DATABASE CONNECTION
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_database_name
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# EMAIL CONFIGURATION
EMAIL_SENDER=noreply@yourdomain.com
EMAIL_FEEDBACK=feedback@yourdomain.com
EMAIL_MAILER=NodeMailer # NodeMailer (default) | Resend

# NodeMailer (Gmail example)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=your-email@gmail.com
EMAIL_SERVER_PASS=your-app-password

# Resend (alternative email service)
EMAIL_RESEND_API_KEY=your_resend_api_key

# HubSpot CRM Integration
HUBSPOT_API_KEY=your_hubspot_private_app_access_token

# Calendly Integration
# Personal Access Token from https://calendly.com/integrations/api_webhooks
# Used to fetch scheduled events for the contact's Meetings tab and the /dashboard/calendar grid.
CALENDLY_API_TOKEN=your_calendly_personal_access_token

# License System Configuration
LICENSE_ENCRYPTION_KEY=your-32-character-encryption-key-here

# Competitor Monitoring Agent (/admin/monitoring)
# The active provider is chosen in the admin UI; only that provider's key is
# required. Keys stay server-side and are never written to the database.
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key
OPENAI_API_KEY=sk-your_openai_api_key

# Shared secret for the scheduled sitemap check.
# POST/GET https://<host>/api/cron/monitoring with:
#   Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate-a-long-random-string